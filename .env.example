# Copy to .env and fill in. These are passwords YOU invent. Nothing is bought, nothing phones home.
# Generate strong values, e.g.:  openssl rand -hex 24
# .env is git-ignored. Never commit it.

# The "password" clients send to your proxy (admin access). In real use the value must
# begin with the letters s, k, hyphen (LiteLLM requires that prefix), e.g. that prefix
# followed by the output of `openssl rand -hex 24`. Hand out VIRTUAL keys from the UI,
# not this one.
LITELLM_MASTER_KEY=CHANGE_ME
# Encrypts DB rows (stored provider keys). Set once, NEVER change, or stored keys become unreadable.
LITELLM_SALT_KEY=CHANGE_ME
# Postgres password. The volume is initialised with it on first start; changing it later breaks the DB.
POSTGRES_PASSWORD=CHANGE_ME
# Admin UI login at http://<box-lan-ip>:4000/ui
UI_USERNAME=admin
UI_PASSWORD=CHANGE_ME

# --- pick ONE cloud backend (optional). No signin on the box needed for these. ---
# ollama.com/settings/keys
OLLAMA_API_KEY=
# deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
